# Copy to mesh.env (gitignored) and fill in. Read at build time.
WIFI_SSID=my-network
WIFI_PASS=my-password
# The control server, and a key the first time this board joins.
MESH_CONTROL_URL=http://192.168.1.10:37767
MESH_AUTH_KEY=tskey-...
# A peer to reach (name or tailnet IP) on port 80.
MESH_PEER=peer
# DERP relays only (false), or also direct UDP paths (true, the default).
# MESH_DIRECT=true
# A private CA for the control server's DERP (e.g. the mesh lab's CA,
# written by testing/mesh-lab/lab.sh esp32-env), trusted instead of the
# public roots unless MESH_CA_ONLY=false.
# MESH_CA_PEM_FILE=/path/to/ca.pem
# MESH_CA_ONLY=true
# Where to set the clock from (DERP's certificate check needs the date).
# Empty: pool.ntp.org on Wi-Fi; over PPP, the host (e.g. the lab's NTP).
# MESH_SNTP_SERVER=192.168.1.10
