# Rust needs larger stacks than ESP-IDF's defaults.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_PTHREAD_TASK_STACK_SIZE_DEFAULT=16384
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# The app is larger than the default 1 MB partition: flash with
# `espflash flash --partition-table partitions.csv` (a 4 MB factory app).
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y

# Sockets: control, DERP, UDP, tokio's eventfd, the peer connection, spare.
CONFIG_LWIP_MAX_SOCKETS=16

# PSRAM on boards that have it (the S3 dev kits); ignored without.
CONFIG_SPIRAM=y
CONFIG_SPIRAM_IGNORE_NOTFOUND=y
CONFIG_SPIRAM_USE_MALLOC=y

# Wi-Fi: fewer buffers, more heap for the node.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=6
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16

# No Bluetooth.
CONFIG_BT_ENABLED=n

# PPP over the USB-serial UART (MESH_LINK=ppp).
CONFIG_LWIP_PPP_SUPPORT=y
